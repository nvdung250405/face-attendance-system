{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Python Configuration for Kiosk App
  "python.defaultInterpreterPath": "${workspaceFolder}/app/kiosk-app/.venv/Scripts/python.exe",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",

  // QML & Qt Configuration for Kiosk App
  "qml.qmlImportPaths": [
    "${workspaceFolder}/app/kiosk-app/.venv/Lib/site-packages/PySide6/qml",
    "${workspaceFolder}/app/kiosk-app/resources/qml"
  ],
  "qt.qmlImportPaths": [
    "${workspaceFolder}/app/kiosk-app/.venv/Lib/site-packages/PySide6/qml",
    "${workspaceFolder}/app/kiosk-app/resources/qml"
  ],
  "qmlls.includePaths": [
    "${workspaceFolder}/app/kiosk-app/.venv/Lib/site-packages/PySide6/qml",
    "${workspaceFolder}/app/kiosk-app/resources/qml"
  ],
  "qml.qmllint.executablePath": "${workspaceFolder}/app/kiosk-app/.venv/Lib/site-packages/PySide6/qmllint.exe",

  // Java Configuration for Backend Service
  "java.jdt.ls.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot",
  "java.jdt.ls.vmargs": "-javaagent:\"C:/Users/Dung/.m2/repository/org/projectlombok/lombok/1.18.46/lombok-1.18.46.jar\" -XX:+EnableDynamicAgentLoading",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot",
      "default": true
    }
  ],
  "java.compile.nullAnalysis.mode": "automatic",
  "java.autobuild.enabled": false,

  // Web Portal Configuration (TypeScript, React, Tailwind)
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python"
  },
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "search.useGlobalIgnoreFiles": false,
  "java.configuration.updateBuildConfiguration": "automatic"
}
