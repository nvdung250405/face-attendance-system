# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Java & Python: 4 spaces
[*.{java,py}]
indent_size = 4

# Web & UI (TypeScript, JavaScript, QML, HTML, CSS): 2 spaces
[*.{js,jsx,ts,tsx,html,css,scss,vue,qml}]
indent_size = 2

# Data & Config (JSON, YAML, XML, TOML): 2 spaces
[*.{json,yaml,yml,xml,toml}]
indent_size = 2

# Markdown documentation (preserve intentional trailing spaces for line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require tab indentation
[Makefile]
indent_style = tab
