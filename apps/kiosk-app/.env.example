# ==============================================================================
# CẤU HÌNH TRẠM KIOSK ĐIỂM DANH SINH TRẮC HỌC (FAS KIOSK APP)
# ==============================================================================

# 0. Môi trường vận hành: dev, staging, prod
APP_ENV=dev

# 1. Định danh trạm Kiosk & Kết nối máy chủ trung tâm
KIOSK_ID=KIOSK-LOBBY-01
KIOSK_BACKEND_URL=http://localhost:8080/api/v1
KIOSK_WS_URL=ws://localhost:8080/ws
KIOSK_SECRET_TOKEN=Kiosk_Internal_Secret_Token_2026

# 2. Cấu hình Camera vật lý (USB Webcam / MIPI CSI)
CAMERA_DEVICE_INDEX=0
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720
CAMERA_FPS=30

# 3. Ngưỡng AI & Nghiệp vụ chấm công
LIVENESS_THRESHOLD=0.85
COSINE_SIMILARITY_THRESHOLD=0.65
STABILITY_SECONDS=0.60
COOLDOWN_SECONDS=120
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# 4. Hàng đợi đệm ngoại tuyến (SQLite WAL)
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_SECONDS=10
