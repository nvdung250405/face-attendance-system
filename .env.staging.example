# ==============================================================================
# HỆ THỐNG ĐIỂM DANH KHUÔN MẶT (FAS) - CẤU HÌNH MÔI TRƯỜNG STAGING
# File mẫu: .env.staging.example -> Sao chép thành .env.staging trên máy chủ Staging
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cơ sở dữ liệu PostgreSQL (Mạng nội bộ Staging)
# ------------------------------------------------------------------------------
DB_HOST=fas-postgres
DB_PORT=5432
DB_NAME=fas_staging_db
DB_USER=fas_staging_admin
# BẮT BUỘC ĐỔI: Mật khẩu CSDL mạnh cho môi trường staging
DB_PASSWORD=CHANGE_ME_staging_db_password_very_secure

# ------------------------------------------------------------------------------
# 2. Máy chủ Backend Spring Boot (Staging Profile)
# ------------------------------------------------------------------------------
APP_ENV=staging
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=staging
BOOTSTRAP_ADMIN_EMAIL=staging-admin@fas.company.com
# BẮT BUỘC ĐỔI: Mật khẩu khởi tạo admin quản trị staging (tối thiểu 12 ký tự)
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_staging_admin_password_123!

# ------------------------------------------------------------------------------
# 3. Bảo mật & Mã hóa — BẮT BUỘC SINH MỚI
# ------------------------------------------------------------------------------
# JWT_SECRET: Chuỗi ngẫu nhiên tối thiểu 32 ký tự bảo mật (HS256)
JWT_SECRET=CHANGE_ME_staging_jwt_secret_must_be_at_least_32_characters_long
# ENCRYPTION_MASTER_KEY: Đúng 64 ký tự Hex (32 bytes) dùng cho AES-256-GCM
ENCRYPTION_MASTER_KEY=CHANGE_ME_staging_64_hex_chars_000000000000000000000000000000000000000
# Thời hạn token JWT (giờ) và thời gian ân hạn điểm danh (phút)
JWT_EXPIRATION_HOURS=2
GRACE_PERIOD_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Tên miền & CORS Whitelist (Chỉ cho phép domain Staging)
# ------------------------------------------------------------------------------
FAS_CORS_ALLOWED_ORIGINS=https://staging.fas.company.com,https://staging-portal.fas.company.com

# ------------------------------------------------------------------------------
# 5. Tham số Nghiệp vụ & AI Engine
# ------------------------------------------------------------------------------
# Token xác thực trạm Kiosk do Backend cấp
KIOSK_SECRET_TOKEN=CHANGE_ME_staging_kiosk_secret_token
LIVENESS_THRESHOLD=0.88
COSINE_SIMILARITY_THRESHOLD=0.68
COOLDOWN_SECONDS=120
COMPLIANCE_DATA_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 6. Cổng Web Portal (Web Host Port & Vite Bundler)
# ------------------------------------------------------------------------------
WEB_PORT=3000
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws-attendance
VITE_BACKEND_TARGET=http://fas-backend:8080

# ------------------------------------------------------------------------------
# 7. Trạm Kiosk Desktop (Khi trỏ từ thiết bị Kiosk thật tới máy chủ Staging)
# ------------------------------------------------------------------------------
KIOSK_ID=KIOSK-STAGING-01
KIOSK_BACKEND_URL=https://staging-api.fas.company.com/api/v1
KIOSK_WS_URL=wss://staging-api.fas.company.com/ws-attendance
CAMERA_DEVICE_INDEX=0
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720
