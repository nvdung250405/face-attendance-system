# ==============================================================================
# CỔNG WEB PORTAL (FAS) - BIẾN MÔI TRƯỜNG CLIENT
# ==============================================================================

# Đường dẫn API cơ sở (hỗ trợ đường dẫn tương đối qua Vite Dev Proxy / Nginx Reverse Proxy)
VITE_API_BASE_URL=/api/v1

# Địa chỉ STOMP WebSocket Broker
VITE_WS_BASE_URL=/ws-attendance

# Địa chỉ Backend Service cho Vite Dev Server Reverse Proxy
VITE_BACKEND_TARGET=http://localhost:8080
