# ==============================================================================
# CẤU HÌNH HỆ THỐNG CHẤM CÔNG FAS (BIẾN MÔI TRƯỜNG DÙNG CHUNG)
# ==============================================================================

# Cơ sở dữ liệu PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fas_db
DB_USER=fas_admin
DB_PASSWORD=CHANGE_ME_db_password

# Máy chủ Backend Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
BOOTSTRAP_ADMIN_EMAIL=admin@fas.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars

# Bảo mật & Mật mã học — BẮT BUỘC đổi trước khi triển khai
# JWT_SECRET: chuỗi ngẫu nhiên tối thiểu 32 ký tự
# ENCRYPTION_MASTER_KEY: 64 ký tự hex (32 byte) cho AES-256-GCM
JWT_SECRET=CHANGE_ME_random_jwt_secret_at_least_32_chars
ENCRYPTION_MASTER_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000000

# Tham số Nghiệp vụ & AI
# KIOSK_SECRET_TOKEN: mã bí mật riêng của trạm Kiosk (lấy từ API đăng ký kiosk, mỗi trạm một mã)
KIOSK_SECRET_TOKEN=CHANGE_ME_kiosk_secret_token
LIVENESS_THRESHOLD=0.85
COSINE_SIMILARITY_THRESHOLD=0.65
COOLDOWN_SECONDS=120
COMPLIANCE_DATA_RETENTION_DAYS=20

# Cấu hình Trạm Kiosk Desktop (app/kiosk-app)
KIOSK_ID=KIOSK-LOBBY-01
CAMERA_DEVICE_INDEX=0
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720

# Cổng Web Portal
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws-attendance
VITE_BACKEND_TARGET=http://localhost:8080
